# Placeholder-only template. Never put real credentials in this file.
# Server-only: required for all live Meta workflows.
META_MODEL_API_KEY=REPLACE_WITH_YOUR_META_MODEL_API_KEY

# Browser-visible Lovable Cloud configuration: these are public configuration,
# not private credentials. Copy your own project's values for local development.
VITE_SUPABASE_URL=https://YOUR_BACKEND_HOST.invalid
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_PUBLIC_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_IDENTIFIER

# Optional SSR runtime counterparts for an externally configured environment.
SUPABASE_URL=https://YOUR_BACKEND_HOST.invalid
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_PUBLIC_PUBLISHABLE_KEY

# No service-role/admin key is needed by the current agent workflows.
# Legacy META_MUSE_SPARK_API_KEY, META_IMAGE_API_KEY and BRAND_VERIFIER_API_KEY
# occur in old placeholder adapters; do not configure them for the live demo.
# LOVABLE_CRON_SECRET / LOVABLE_CRON_SECRET_PREVIOUS belong to unused generated
# cron helpers, not this application's live workflow.